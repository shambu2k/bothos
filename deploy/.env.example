# Copy to .env (gitignored) and fill in real values, then: docker compose up -d
# This is the webhook secret shared with GitHub — must match the repo/organization webhook.
GITHUB_WEBHOOK_SECRET=change-me
# Local Postgres password for the maintbot role.
POSTGRES_PASSWORD=maintbot-dev
# Read-only fine-grained PAT (contents: read) for scanning PRIVATE repos. Public
# repos scan without it. Never use a write-scoped token here.
#GITHUB_READ_TOKEN=
