# Copy to .env (gitignored) and fill in real values, then: docker compose up -d
# This is the webhook secret shared with GitHub — must match the repo/organization webhook.
GITHUB_WEBHOOK_SECRET=change-me
# Local Postgres password for the maintbot role.
POSTGRES_PASSWORD=maintbot-dev
# Read-only fine-grained PAT (contents: read) for scanning PRIVATE repos. Public
# repos scan without it. Never use a write-scoped token here.
#GITHUB_READ_TOKEN=

# ---- Phase 2 (upgrade PRs) ----
# Write fine-grained PAT (contents: write, pull_requests: write) for the target
# repo/account. The GLOBAL GITHUB_WRITE_TOKEN is the default; a per-account
# GITHUB_WRITE_TOKEN_<ACCOUNTID> is an optional override for that account.
# Executor-only: the token is stripped from the agent subprocess environment.
#GITHUB_WRITE_TOKEN=
#GITHUB_WRITE_TOKEN_ACME=
# LLM provider for the PI agent runtime (OpenRouter). Model override optional.
#OPENROUTER_API_KEY=
#PI_MODEL=openrouter/deepseek/deepseek-v4-flash-0731
# pi CLI binary (RPC mode). Defaults to "pi" on PATH inside the worker image.
#PI_BIN=pi
# Persistent per-run PI session dir (mounted into the worker). Default in-image.
#PI_SESSION_DIR=/var/lib/bothos/sessions
# Optional web_search tool for the agent (tavily | brave by SEARCH_PROVIDER).
# WITHOUT this the agent still works using pure LLM reasoning — search is optional.
#SEARCH_API_KEY=
#SEARCH_PROVIDER=tavily
